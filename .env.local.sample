NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000/api
NEXT_PUBLIC_SITE_NAME=ogImage.click

# Microsoft Clarity Analytics (optional for local dev)
NEXT_PUBLIC_CLARITY_ID=

# Cloudflare R2 (S3-compatible) - 可选配置
# 设置为 true 启用 R2 持久化存储，否则直接返回图片二进制
ENABLE_R2_STORAGE=false

# Debug mode for R2 operations (logs to console)
DEBUG_R2=false

R2_ENDPOINT=
R2_REGION=auto
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=

